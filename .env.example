# Copy to .env for local development (`devbox services up` or `npm run dev`).
# .env is git-ignored; never commit real credentials.

# Postgres; process-compose sets this to the local devbox-db container by default.
RBACR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Addresses and/or domains that are roots (all roles in all systems).
RBACR_ROOT_LIST=you@example.com

# Google OAuth web client. Authorised redirect URIs: https://local.rbacr.nu01.com:8444/login/google/callback
# (local HTTPS through Floci, the default under `devbox services up`), https://rc.rbacr.nu01.com/login/google/callback
# and https://rbacr.nu01.com/login/google/callback.
RBACR_GOOGLE_CLIENT_ID=
RBACR_GOOGLE_CLIENT_SECRET=

# RBACR_PUBLIC_ORIGIN, the origin Google redirects back to, is set by
# process-compose (default https://local.rbacr.nu01.com:8444, which wins over
# this file). To sign in on http://localhost:5173 instead, export
# RBACR_PUBLIC_ORIGIN=http://localhost:5173 before `devbox services up`.

# Password-less /login/dev for local testing. Ignored by production builds.
RBACR_DEV_LOGIN=1
